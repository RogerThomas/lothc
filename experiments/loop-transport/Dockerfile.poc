FROM rust:1-slim AS poc-builder
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN uv python install 3.14
WORKDIR /build
COPY poc/ ./
RUN uv tool run maturin build --release -i "$(uv python find 3.14)" -o /wheels

FROM reqwest-floor-py-bench:latest
COPY --from=poc-builder /wheels /wheels
RUN uv pip install --python /app/.venv/bin/python /wheels/*.whl
